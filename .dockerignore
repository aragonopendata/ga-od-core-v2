# Keep the build context minimal: the image only needs requirements.txt,
# the application source and the helper scripts. Everything else -- and in
# particular any runtime configuration or credentials -- is excluded.
*

!requirements.txt
!src
!scripts

# Runtime configuration and secrets must never enter the image; they are
# mounted at container start (see CONFIG_PATH in docker-compose.yaml).
**/config.yaml
**/config2.yaml
**/config-tst.yaml
**/config.template.yaml
**/.env
**/.env.*

# Python build and cache artefacts
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache

# Compiled catalogues are regenerated by `django-admin compilemessages`
**/*.mo

# Generated at container start by `manage.py collectstatic`
src/staticfiles

# Local databases, logs and scratch output
**/*.sqlite3
**/*.sqlite3-journal
**/*.log
